generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum BillingTier {
  TRIAL
  BASIC
  STANDARD
  PROFESSIONAL
  ENTERPRISE
  ENTERPRISE_PLUS
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model Tenant {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  minuteBalance Int         @default(0)
  billingTier   BillingTier @default(TRIAL)

  members       WorkspaceMember[]
  campaigns     Campaign[]
  contacts      Contact[]
  callModules   CallModule[]
  callLogs      CallLog[]
  notifications Notification[]
}

model User {
  id           String     @id @default(uuid()) @map("_id")
  email        String     @unique
  name         String
  avatarUrl    String?
  passwordHash String?
  googleId     String?
  role         Role       @default(VIEWER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  invitedById  String?
  invitedBy    User?      @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitedUsers User[]     @relation("UserInvitedBy")

  workspaces     WorkspaceMember[]
  refreshTokens  RefreshToken[]
  campaigns      Campaign[]
  notifications  Notification[]

  @@index([googleId])
  @@index([invitedById])
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  tenantId    String
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id])
  tenant  Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("_id")
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CallModule {
  id              String     @id @default(uuid()) @map("_id")
  name            String
  prompt          String?

  goal            String?
  callIntro       String?
  callSignOff     String?
  courtesyClose   Boolean   @default(false)

  successCriteria String?
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  campaigns       Campaign[]
}

model Campaign {
  id            String       @id @default(uuid()) @map("_id")
  name          String
  type          CampaignType @default(HR)
  dataToCollect Json?
  endCallIf     String?
  rules         Json?
  callSettings  Json?

  maxCallDurationSec    Int?
  estimatedTotalMinutes Int?

  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  callModuleId String
  callModule   CallModule @relation(fields: [callModuleId], references: [id])

  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id])

  campaignContacts CampaignContact[]
  callLogs         CallLog[]
  createdAt        DateTime          @default(now())
}

model Contact {
  id       String @id @default(uuid()) @map("_id")
  name     String
  phone    String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  campaignContacts CampaignContact[]
  callLogs         CallLog[]
}

model CampaignContact {
  id         String @id @default(uuid()) @map("_id")
  campaignId String
  contactId  String
  overrides  Json?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])
}

model CallLog {
  id           String    @id @default(uuid()) @map("_id")
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id])
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  status       String
  transcript   String?
  recordingUrl String?
  providerRef  String?
  durationMs      Int?
  billableMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum CampaignType {
  HR
  RECRUITER
  SALES
  LOAN_RECOVERY
  FEEDBACK
}

model Notification {
  id        String           @id @default(uuid()) @map("_id")
  userId    String
  tenantId  String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId, createdAt(sort: Desc)])
  @@index([userId, tenantId, isRead])
}

enum NotificationType {
  CAMPAIGN_CREATED
  CAMPAIGN_STARTED
  CAMPAIGN_PAUSED
  CAMPAIGN_KILLED
  CAMPAIGN_RERUN
  CAMPAIGN_COMPLETED
  CALL_COMPLETED
  CALL_FAILED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  SUPPORT_TICKET_SUBMITTED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_RESOLVED
  TOPUP_SUCCESS
  BALANCE_LOW
  BALANCE_DEPLETED
}
