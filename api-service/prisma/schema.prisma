generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum BillingTier {
  TRIAL
  BASIC
  STANDARD
  PROFESSIONAL
  ENTERPRISE
  ENTERPRISE_PLUS
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

model Tenant {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  minuteBalance Int         @default(0)
  billingTier   BillingTier @default(TRIAL)

  members        WorkspaceMember[]
  invites        Invite[]
  campaigns      Campaign[]
  contacts       Contact[]
  callModules    CallModule[]
  callLogs       CallLog[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  topUps         TopUp[]
}

model User {
  id           String     @id @default(uuid()) @map("_id")
  email        String     @unique
  name         String
  avatarUrl    String?
  passwordHash String?
  googleId     String?
  role         Role       @default(VIEWER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  invitedById  String?
  invitedBy    User?      @relation("UserInvitedBy", fields: [invitedById], references: [id])
  invitedUsers User[]     @relation("UserInvitedBy")

  workspaces      WorkspaceMember[]
  refreshTokens   RefreshToken[]
  campaigns       Campaign[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  supportReplies  SupportTicketReply[]

  @@index([googleId])
  @@index([invitedById])
}

model WorkspaceMember {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  tenantId    String
  role        Role     @default(VIEWER)
  createdAt   DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id])
  tenant  Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("_id")
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CallModule {
  id              String     @id @default(uuid()) @map("_id")
  name            String
  prompt          String?

  goal            String?
  callIntro       String?
  callSignOff     String?
  courtesyClose   Boolean   @default(false)

  successCriteria String?
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  campaigns       Campaign[]
}

model Campaign {
  id            String       @id @default(uuid()) @map("_id")
  name          String
  type          CampaignType @default(HR)
  dataToCollect Json?
  endCallIf     String?
  rules         Json?
  callSettings  Json?

  maxCallDurationSec    Int?
  estimatedTotalMinutes Int?

  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  callModuleId String
  callModule   CallModule @relation(fields: [callModuleId], references: [id])

  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id])

  campaignContacts CampaignContact[]
  callLogs         CallLog[]
  shareLinks       ShareLink[]
  createdAt        DateTime          @default(now())
}

model Invite {
  id        String   @id @default(uuid()) @map("_id")
  token     String   @unique @default(uuid())
  email     String
  firstName String?
  lastName  String?
  phone     String?
  role      Role     @default(VIEWER)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  invitedById String?

  @@index([email])
}

model ShareLink {
  id         String   @id @default(uuid()) @map("_id")
  token      String   @unique
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  tenantId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Contact {
  id       String @id @default(uuid()) @map("_id")
  name     String
  phone    String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  campaignContacts CampaignContact[]
  callLogs         CallLog[]
}

model CampaignContact {
  id         String @id @default(uuid()) @map("_id")
  campaignId String
  contactId  String
  overrides  Json?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  contact  Contact  @relation(fields: [contactId], references: [id])
}

model CallLog {
  id              String    @id @default(uuid()) @map("_id")
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  contactId       String
  contact         Contact   @relation(fields: [contactId], references: [id])
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  status          String
  transcript      String?
  recordingUrl    String?
  providerRef     String?
  durationMs      Int?
  billableMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TopUp {
  id                  String   @id @default(uuid()) @map("_id")
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  packId              String
  razorpayOrderId     String?  @unique
  razorpayPaymentId   String?
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}

enum CampaignType {
  HR
  RECRUITER
  SALES
  LOAN_RECOVERY
  FEEDBACK
}

// ==========================================
// NOTIFICATION MODELS
// ==========================================

enum NotificationType {
  CAMPAIGN_CREATED
  CAMPAIGN_STARTED
  CAMPAIGN_PAUSED
  CAMPAIGN_KILLED
  CAMPAIGN_RERUN
  CAMPAIGN_COMPLETED
  CALL_COMPLETED
  CALL_FAILED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_STATUS_CHANGED
  MEMBER_REMOVED
  SUPPORT_TICKET_SUBMITTED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_RESOLVED
  TOPUP_SUCCESS
  BALANCE_LOW
  BALANCE_DEPLETED
}

model Notification {
  id        String           @id @default(uuid()) @map("_id")
  userId    String
  tenantId  String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId, createdAt(sort: Desc)])
  @@index([userId, tenantId, isRead])
}

// ==========================================
// SUPPORT TICKET MODELS
// ==========================================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(uuid()) @map("_id")
  userId    String
  tenantId  String?
  subject   String
  message   String              
  category  String              @default("general")
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])
  replies SupportTicketReply[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([status, createdAt(sort: Desc)])
}

model SupportTicketReply {
  id        String        @id @default(uuid()) @map("_id")
  ticketId  String
  userId    String
  message   String        
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

// ==========================================
// EVALUATION SERVICE MODELS
// ==========================================

model CallReport {
  id             String   @id @default(uuid()) @map("_id")
  callLogId      String   @unique
  campaignId     String?
  tenantId       String?
  contactName    String?
  contactPhone   String?

  outcome        String?
  failureReason  String?  
  sentiment      String?  
  score          Int?     
  reportSummary  String?  
  completionRate Float?   

  extractedFields Json?   
  missingFields   Json?   
  complianceData  Json?   
  scoreBreakdown  Json?   
  reportData      Json?   

  schemaVersion  String   @default("1.0")
  modelVersion   String?  

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job            ReportJob?

  @@index([campaignId, outcome])
  @@index([campaignId, score])
  @@index([campaignId, sentiment])
  @@index([campaignId, createdAt])
  @@index([tenantId, createdAt])
}

model ReportJob {
  id               String     @id @default(uuid()) @map("_id")
  callLogId        String     @unique
  report           CallReport @relation(fields: [callLogId], references: [callLogId])

  ingestStatus     String     @default("pending")
  normalizeStatus  String     @default("pending")
  extractStatus    String     @default("pending")
  evaluateStatus   String     @default("pending")
  complianceStatus String     @default("pending")
  assembleStatus   String     @default("pending")

  totalAttempts    Int        @default(0)
  lastError        String?
  priority         Int        @default(1) 

  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([extractStatus])
  @@index([assembleStatus])
}

model DLQEntry {
  id         String   @id @default(uuid()) @map("_id")
  callLogId  String
  stage      String
  payload    Json
  error      String
  stackTrace String?
  attempts   Int
  canRetry   Boolean  @default(true)
  retried    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([callLogId])
  @@index([stage])
  @@index([retried])
}
