# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in real values.
# NEVER commit .env — only commit this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL:      postgresql://user:password@localhost:5432/aicalling
# RAILWAY:    (auto-provided by Railway Postgres add-on)
DATABASE_URL=mongodb://localhost:27017/aicalling?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000

# ── Twilio ────────────────────────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── AI Providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public URL (ngrok locally / Railway URL in production) ────────────────────
# LOCAL:      https://xxxx-xxxx.ngrok-free.app
# PRODUCTION: https://your-service.railway.app
BASE_URL=https://your-ngrok-or-production-url.app

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Call limits ───────────────────────────────────────────────────────────────
MAX_CONCURRENT_CALLS=10
MAX_CALLS_PER_TENANT=5
MAX_CONFUSION_RETRIES=2

# ── Google Cloud (service account — Speech-to-Text / Text-to-Speech) ──────────
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Google OAuth (Sign in with Google) ────────────────────────────────────────
# Separate from the service account above — these come from an OAuth 2.0 Client
# ID in Google Cloud Console → APIs & Services → Credentials. Leave blank and
# the /api/auth/google routes bounce back to the login page with a clear error
# instead of failing. GOOGLE_CALLBACK_URL must be registered verbatim as an
# Authorised redirect URI on that client.
# LOCAL:      http://localhost:3000/api/auth/google/callback
# PRODUCTION: https://api.aicaller.store/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── Frontend origin (OAuth redirects land here after sign-in) ─────────────────
# LOCAL:      http://localhost:5173
# PRODUCTION: https://aicaller.store
FRONTEND_URL=http://localhost:5173

# ── Notification channels ─────────────────────────────────────────────────────
# In-app notifications always work. Email and SMS are layered on top and each
# stays dormant until its own vars are set — an unconfigured channel is skipped,
# never an error.
# Email (Resend):
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=AI Caller Pro
# SMS (Twilio) — TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN are set in the Twilio
# block above; this is the sending number in E.164.
TWILIO_SMS_FROM=
# Optional routing overrides. Comma-separated NotificationType values, or "*"
# for all. Unset = defaults (email for everything; SMS only for urgent types,
# and only for users who opted in).
NOTIFY_EMAIL_TYPES=
NOTIFY_SMS_TYPES=
